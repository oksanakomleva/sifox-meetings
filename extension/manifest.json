{
  "manifest_version": 3,
  "name": "Sifox Meetings Recorder",
  "version": "0.3.2",
  "description": "Запись любой встречи в браузере (звук вкладки + микрофон) прямо в Sifox Meetings.",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "tabs", "cookies", "alarms"],
  "host_permissions": [
    "https://sifox-meetings.up.railway.app/*",
    "http://localhost:8000/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sifox Recorder"
  },
  "background": {
    "service_worker": "background.js"
  }
}

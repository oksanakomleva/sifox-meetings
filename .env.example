# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=your-random-32-byte-hex-here
BASE_URL=https://your-app.railway.app
ALLOWED_DOMAIN=sifox.com
ADMIN_EMAILS=oksana.komleva@sifox.com

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create at console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URIs: https://your-app.railway.app/api/auth/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Whisper ───────────────────────────────────────────────────────────────────
WHISPER_MODEL=medium

# ── Live in-meeting assistant ("Протоколлер, …") — off by default ─────────────
# When enabled, the bot listens for the wake word during the meeting and answers
# from meetings/Mattermost/email (internal meetings) or only the current meeting
# (external). Resource-heavy; roll out carefully. Voice answer (TTS) is Phase 3.
LIVE_ASSISTANT_ENABLED=false
# LIVE_WAKE_WORD=протоколлер
# LIVE_WAKE_MODEL=tiny
# LIVE_QUESTION_MODEL=small
# LIVE_WINDOW_SEC=5
# LIVE_QUESTION_MAX_SEC=12
# LIVE_BUFFER_MIN=10
# Phase 3 — speak the answer into the meeting (TTS). Separate flag: risky mic/
# voice path only runs when BOTH this and LIVE_ASSISTANT_ENABLED are true.
LIVE_ASSISTANT_SPEAK=false
# LIVE_TTS=openai            # openai | espeak
# LIVE_TTS_MODEL=tts-1
# LIVE_TTS_VOICE=alloy

# ── Storage (Railway Volume) ──────────────────────────────────────────────────
AUDIO_DIR=/audio

# ── Encryption ───────────────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# ── Recording ─────────────────────────────────────────────────────────────────
JOIN_BEFORE_MINUTES=1
PARTICIPANT_POLL_INTERVAL=30
EMPTY_POLLS_TO_END=3

# ── Communications ingestion (optional; sync loops are no-ops if unset) ────────
# Mattermost: bot/personal access token; syncs channels the token is a member of.
MM_TOKEN=
MM_SERVER_URL=https://mattermost.yourcompany.com
# Gmail via Service Account + Domain-Wide Delegation. Inline JSON or a file path.
# A Workspace super-admin must authorize the SA client_id for scope
# https://www.googleapis.com/auth/gmail.readonly (Admin console → API controls).
GOOGLE_SERVICE_ACCOUNT_JSON=
GMAIL_BOOTSTRAP_DAYS=30
MM_SYNC_MINUTES=15
GMAIL_SYNC_MINUTES=30
